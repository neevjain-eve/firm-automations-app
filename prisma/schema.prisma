generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?  // bcrypt hash -- optional; not needed once signed in via Microsoft/Azure AD
  role      String   @default("staff") // "staff" | "manager" | "admin"
  // "pending" | "approved" | "rejected". Self-serve signups and first-time
  // Microsoft sign-ins land on "pending" until an admin approves them from
  // the /admin panel; accounts an admin creates directly default straight
  // to "approved". Only "approved" accounts can actually sign in.
  status    String   @default("approved")
  // Which trackers (by key, matching TRACKER_KEYS in lib/permissions.ts) this
  // account may open. Ignored for role "admin" (admins always see everything).
  // Set by an admin from the /admin user-management panel.
  allowedTrackers String[] @default([])
  createdAt DateTime @default(now())

  runs               AutomationRun[]
  statusTasks        StatusTask[]
  agreements         Agreement[]
  gstReconciliations GstReconciliation[]
  leaseAgreements    LeaseAgreement[]
  toDoTasksCreated   ToDoTask[]         @relation("ToDoTasksCreated")
  toDoAssignments    ToDoAssignee[]
  toDoWorkLogs       ToDoWorkLog[]
  policiesCreated    Policy[]
  policySignatures   PolicySignature[]
  comments           Comment[]
  attachments        Attachment[]
  gstClients         GstClient[]
  gstImportJobs      GstImportJob[]
  gstDecisionsReviewed GstDecision[] @relation("GstDecisionReviewedBy")
}

// Admin-editable configuration that would otherwise live in env vars, set
// from Settings -> Connections. Secret values (e.g. the Azure AD client
// secret) are stored encrypted with SETTINGS_ENCRYPTION_KEY -- see
// lib/crypto.ts. DATABASE_URL deliberately does NOT live here: the app needs
// a database connection before it can read this table.
model AppSetting {
  key       String   @id
  value     String   @db.Text // AES-256-GCM ciphertext when isSecret
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Generic comment thread attachable to any tracker entity (Status Tracker task,
// Agreement, GST reconciliation row, Lease, To-Do task). entityType is a short
// tag like "status_task" | "agreement" | "gst" | "lease" | "todo_task", and
// entityId is that record's id. Kept generic so every tracker gets comments
// without a separate table per tracker.
model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

// Generic file attachment, same polymorphic pattern as Comment. Files are
// stored in Vercel Blob storage -- this row just tracks metadata + the URL.
model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  fileSize   Int
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

// One row per automation execution. This is the audit trail --
// keep it even after the automations themselves evolve.
model AutomationRun {
  id           String   @id @default(cuid())
  automationId String // e.g. "mis-rollforward", "je-prep", "reconciliation"
  status       String   @default("running") // "running" | "success" | "failed"
  input        Json?
  output       Json?
  error        String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([automationId])
  @@index([userId])
}

// Status Tracker -- field set matches the original Status-Tracker app
// (Task Name, Client, Manager, Team Member, Priority, Status, Due Date,
// Description, Blockers, Action Points). No OneDrive sync or AI assistant --
// this is backed by the firm's own database instead.
model StatusTask {
  id           String    @id @default(cuid())
  title        String    // Task Name
  clientName   String?
  manager      String?
  teamMember   String?
  priority     String    @default("medium") // "low" | "medium" | "high"
  status       String    @default("not_started") // "not_started" | "in_progress" | "blocked" | "on_hold" | "completed"
  notes        String?   // Task Description
  blockers     String?
  actionPoints String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([status])
}

// EL Tracker -- field set matches the original Agreement-Tracker-PDKA app
// (Agreement Type, Client Name, City/Area, dates, value). No OneDrive sync
// or AI assistant -- this is backed by the firm's own database instead.
model Agreement {
  id             String    @id @default(cuid())
  name           String
  clientName     String
  agreementType  String?   // e.g. "Advisory Services Agreement"
  city           String?
  areaLocality   String?
  startDate      DateTime
  endDate        DateTime
  amount         Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Renewal chain: when an agreement is renewed, a new row is created that
  // points back at the one it replaced. renewedFromId is null for the
  // original agreement in a chain.
  renewedFromId String?
  renewedFrom   Agreement?  @relation("AgreementRenewal", fields: [renewedFromId], references: [id])
  renewals      Agreement[] @relation("AgreementRenewal")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([endDate])
}

// GST Reconciliation "Filing Status" tracker -- period-level: has the return been filed,
// do the headline figures match. Simple, manual, kept as-is. The invoice-level engine
// (GstClient / GstGstin / GstInvoice / GstDecision below) is the deeper reconciliation tool,
// reachable from the same /gst-reconciliation section.
model GstReconciliation {
  id             String    @id @default(cuid())
  period         String    // e.g. "Jul 2026"
  returnType     String    @default("GSTR-3B") // "GSTR-1" | "GSTR-3B" | "GSTR-2B" | "Annual"
  status         String    @default("pending") // "pending" | "matched" | "mismatch"
  gstin          String?
  dueDate        DateTime?
  filedBy        String?
  amountBooks    Float?
  amountGst      Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([status])
}

// Lease Agreement tracker -- same shape as EL Tracker but for property/asset
// leases: track lessor, rent, and expiry.
model LeaseAgreement {
  id            String    @id @default(cuid())
  propertyName  String
  lessorName    String
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([endDate])
}

// To-Do List Tracker -- field set matches the original TO-DO-LIST app
// (task title, description, due date, priority, department, client,
// multiple assignees, work log entries). No separate employee/manager
// records -- assignees are just the firm's real accounts (via signup).
model ToDoTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("medium") // "low" | "medium" | "high"
  status      String    @default("not_started") // "not_started" | "in_progress" | "completed"
  department  String?
  client      String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("ToDoTasksCreated", fields: [createdById], references: [id])

  assignees ToDoAssignee[]
  workLogs  ToDoWorkLog[]

  @@index([status])
}

model ToDoAssignee {
  id     String @id @default(cuid())
  taskId String
  task   ToDoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model ToDoWorkLog {
  id          String   @id @default(cuid())
  taskId      String
  task        ToDoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  logDate     DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([taskId])
}

// e-Signature -- matches the original PDKASIGN app (staff sign off on a
// company policy: typed name, date, drawn signature). No OneDrive storage or
// Microsoft sign-in -- policies and signatures live in the firm's own
// database, signed with the account each person already has.
model Policy {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text // the policy text staff are acknowledging
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  signatures PolicySignature[]
}

// Backing store for the literally-copied TO-DO-LIST app (app/api routes
// under pages/api/legacy-todo/*, unmodified from the original repo except
// swapping their storage module for this table instead of Vercel KV / local
// JSON files). Each key is one of the original app's collections
// ("employees", "users", "managers", "tasks", "personalTasks", "idSeq"),
// value is that collection's JSON blob -- exactly the shape readJSON/
// writeJSON expects, so the original business logic needs zero changes.
model LegacyTodoStore {
  key   String @id
  value Json
}

// Backing store for the literally-copied Status Tracker frontend
// (public/legacy/status-tracker/index.html, unmodified UI/business logic).
// The original app synced its `tasks`/`clients` data to OneDrive via
// Microsoft Graph, using a master token cached in a public GitHub file
// refreshed by a client-side GitHub write token -- that token leaked
// publicly, so this port replaces that whole relay with this table instead.
// Keys: "config" (users list) and "tasks" ({tasks, clients}).
model LegacyStatusStore {
  key   String @id
  value Json
}

// Backing store for the literally-copied EL Tracker (Agreement Tracker)
// frontend. Same rationale as LegacyStatusStore: the original app's
// OneDrive sync relied on a client-side GitHub write token (also leaked
// publicly) to refresh a shared master token. Keys: "data"
// ({agreements, bills, clientTasks, lastUpdated, updatedBy}) and "users"
// (the app's own staff login list, separate from Firm Automations accounts).
model LegacyElTrackerStore {
  key   String @id
  value Json
}

model PolicySignature {
  id            String   @id @default(cuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  signedName    String
  signatureData String   @db.Text // canvas-drawn signature, PNG data URL
  signedAt      DateTime @default(now())

  @@unique([policyId, userId])
}

// ─────────────────────────── GST Reconciliation (invoice engine) ───────────────────────────
// Adds invoice-level books-vs-GSTR-2B reconciliation on top of the period-level "Filing Status"
// tracker above (GstReconciliation). Firm-wide, not per-user: any user with the gst-reconciliation
// tracker permission can see all clients/GSTINs. Imported rows are never edited or deleted -- a new
// import for the same GSTIN + period + source marks the previous rows `active: false` (kept for
// audit) and inserts fresh ones; reconciliation decisions live in their own table, keyed by a
// content-based matchKey so a staff member's review (accepted / flagged / note) survives re-imports
// and re-runs as long as the same supplier GSTIN + invoice number reappears.

model GstClient {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  gstins      GstGstin[]
}

model GstGstin {
  id       String @id @default(cuid())
  gstin    String @unique
  label    String? // e.g. "Karnataka HO", "Mumbai branch"
  clientId String
  client   GstClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  importJobs GstImportJob[]
  invoices   GstInvoice[]
  decisions  GstDecision[]

  @@index([clientId])
}

model GstImportJob {
  id           String   @id @default(cuid())
  gstinId      String
  gstin        GstGstin @relation(fields: [gstinId], references: [id], onDelete: Cascade)
  period       String // MMYYYY
  source       String // "BOOKS" | "GSTR2B"
  fileName     String?
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  errorRows    Int      @default(0)
  issues       Json?
  startedAt    DateTime @default(now())

  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  invoices    GstInvoice[]

  @@index([gstinId, period, source])
}

model GstInvoice {
  id                String   @id @default(cuid())
  gstinId           String
  gstin             GstGstin @relation(fields: [gstinId], references: [id], onDelete: Cascade)
  importJobId       String
  importJob         GstImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  period            String // MMYYYY this row belongs to
  source            String // "BOOKS" | "GSTR2B"
  active            Boolean  @default(true) // false once superseded by a newer import for the same gstin+period+source
  docType           String   @default("INVOICE") // "INVOICE" | "CREDIT_NOTE" | "DEBIT_NOTE"
  supplierGstin     String
  supplierName      String?
  invoiceNumber     String
  invoiceNumberNorm String
  invoiceDate       DateTime
  taxableValue      Float    @default(0)
  igst              Float    @default(0)
  cgst              Float    @default(0)
  sgst              Float    @default(0)
  cess              Float    @default(0)
  invoiceValue      Float?
  itcEligible       Boolean  @default(true) // books side: is this bill ITC-eligible
  itcAvailable      Boolean  @default(true) // GSTR-2B side: does the portal mark ITC as available
  itcReason         String?
  raw               Json? // original parsed row, kept for traceability
  createdAt         DateTime @default(now())

  @@index([gstinId, period, source, active])
  @@index([supplierGstin, invoiceNumberNorm])
}

model GstDecision {
  id              String    @id @default(cuid())
  gstinId         String
  gstin           GstGstin  @relation(fields: [gstinId], references: [id], onDelete: Cascade)
  period          String
  matchKey        String // supplierGstin|invoiceNumberNorm|I-or-C -- stable across re-imports
  status          String // ReconStatusStr from lib/gst/engine.ts (MATCHED, NEEDS_REVIEW, ...)
  matchMethod     String // EXACT | NORMALIZED | FUZZY | NONE
  confidence      Int       @default(0)
  explanation     String?   @db.Text
  supplierGstin   String
  supplierName    String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  booksTaxable    Float?
  booksTax        Float?
  gstr2bTaxable   Float?
  gstr2bTax       Float?
  taxableVariance Float     @default(0)
  taxVariance     Float     @default(0)
  booksItc        Float     @default(0)
  gstr2bItc       Float     @default(0)
  matchedItc      Float     @default(0)
  bookInvoiceId   String?
  gstr2bInvoiceId String?
  differences     Json?

  // Staff review, independent of the engine's own classification.
  reviewStatus String    @default("OPEN") // "OPEN" | "ACCEPTED" | "FLAGGED" | "IGNORED"
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedBy   User?     @relation("GstDecisionReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gstinId, period, matchKey])
  @@index([gstinId, period, status])
}
